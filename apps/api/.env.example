# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://hogar:hogar@localhost:5432/hogar
# Database used by the test suite (created by docker/postgres-init.sql).
TEST_DATABASE_URL=postgresql://hogar:hogar@localhost:5432/hogar_test

# OAuth Client ID from Google Cloud (see docs/setup-google-oauth.md). It is public; no client secret is needed.
GOOGLE_CLIENT_ID=

# Secret to sign access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Origin of the web app, used for CORS-free Origin checks on cookie endpoints.
WEB_ORIGIN=http://localhost:5173
PORT=3000
# Set to true in production (HTTPS) so the refresh cookie is only sent over TLS.
COOKIE_SECURE=false
# Reverse proxies in front of the API (0 locally). See docs/deploy.md › Client IP.
TRUST_PROXY_HOPS=0
