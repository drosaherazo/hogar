# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://hogar:hogar@localhost:5432/hogar
# Database used by the test suite (created by docker/postgres-init.sql).
TEST_DATABASE_URL=postgresql://hogar:hogar@localhost:5432/hogar_test
# Scratch database for `pnpm db:check` (also created by docker/postgres-init.sql); Prisma wipes it on every run.
SHADOW_DATABASE_URL=postgresql://hogar:hogar@localhost:5432/hogar_shadow

# OAuth Client ID from Google Cloud (see docs/setup-google-oauth.md). It is public; no client secret is needed.
GOOGLE_CLIENT_ID=

# Secret to sign access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Origin of the web app, used for CORS-free Origin checks on cookie endpoints.
WEB_ORIGIN=http://localhost:5173
PORT=3000
# Set to true in production (HTTPS) so the refresh cookie is only sent over TLS.
COOKIE_SECURE=false
# Reverse proxies in front of the API (0 locally). See docs/deploy.md › Client IP.
TRUST_PROXY_HOPS=0

# Key for the HMAC that protects sign-in codes (at least 32 characters). Generate one like JWT_ACCESS_SECRET.
EMAIL_CODE_SECRET=

# Email (ADR 0008). Locally, Mailpit from Docker Compose: read sent emails at http://localhost:8025.
MAILPIT_URL=http://localhost:8025
# Production: Resend's API key and a sender on Hogar's verified domain (see docs/deploy.md › Email).
# When RESEND_API_KEY is set it wins over MAILPIT_URL. Leave both empty and the API refuses to start.
RESEND_API_KEY=
EMAIL_FROM=
