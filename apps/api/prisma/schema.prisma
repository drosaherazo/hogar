generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A person: one per email address, however they sign in (ADR 0008).
model User {
  id                   String   @id @default(cuid())
  /// The linked Google account (`sub`), if any. At most one per person.
  googleId             String?  @unique @map("google_id")
  /// Always stored trimmed and lower-cased.
  email                String   @unique
  name                 String
  avatarUrl            String?  @map("avatar_url")
  /// Preferred interface language: "en" or "es".
  locale               String   @default("en")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  /// Name of the household an admin removed this person from; shown once, then cleared.
  removedFromHousehold String?  @map("removed_from_household")

  refreshTokens      RefreshToken[]
  membership         Membership?
  invitationsCreated Invitation[]   @relation("InvitationCreatedBy")
  invitationsUsed    Invitation[]   @relation("InvitationUsedBy")

  expensesPaid        Expense[]      @relation("ExpensePaidBy")
  expensesCreated     Expense[]      @relation("ExpenseCreatedBy")
  expensesEdited      Expense[]      @relation("ExpenseEditedBy")
  expensesDeleted     Expense[]      @relation("ExpenseDeletedBy")
  expenseShares       ExpenseShare[]
  settlementsSent     Settlement[]   @relation("SettlementFrom")
  settlementsReceived Settlement[]   @relation("SettlementTo")
  settlementsCreated  Settlement[]   @relation("SettlementCreatedBy")
  settlementsEdited   Settlement[]   @relation("SettlementEditedBy")
  settlementsDeleted  Settlement[]   @relation("SettlementDeletedBy")

  @@map("users")
}

enum Role {
  ADMIN
  MEMBER
  GUEST
}

/// A shared home. It exists only while it has members; the last one to leave deletes it.
model Household {
  id               String    @id @default(cuid())
  name             String
  /// Bumped on create, join, leave and remove, so admins can be asked to review the split.
  membersChangedAt DateTime  @map("members_changed_at")
  /// Last time an admin saved the split; null until the first save.
  splitSavedAt     DateTime? @map("split_saved_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  memberships Membership[]
  invitations Invitation[]
  expenses    Expense[]
  settlements Settlement[]
  categories  ExpenseCategory[]

  @@map("households")
}

/// A person's place in a household. `userId` is unique: one household per user.
/// `weight` (0–100, enforced by a CHECK constraint) drives the default split.
model Membership {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  userId      String   @unique @map("user_id")
  role        Role
  weight      Int      @default(1)
  joinedAt    DateTime @default(now()) @map("joined_at")

  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryWeights CategoryWeight[]

  @@index([householdId])
  @@map("memberships")
}

/// A single-use, time-limited link into a household. Only the SHA-256 of the token is stored.
model Invitation {
  id          String    @id @default(cuid())
  householdId String    @map("household_id")
  role        Role
  tokenHash   String    @unique @map("token_hash")
  createdById String?   @map("created_by_id")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  usedById    String?   @map("used_by_id")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  usedBy    User?     @relation("InvitationUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@map("invitations")
}

/// How an expense's shares were computed.
enum SplitMethod {
  /// The household's split: members' weights when the expense was saved.
  WEIGHTS
  /// Equally among the chosen people.
  EQUAL
  /// An amount per person.
  EXACT
}

/// Money one person paid for the household, in euro cents (1 – 10,000,000, enforced by a CHECK).
/// People are users, not memberships, so the history survives people leaving. Deleting keeps the
/// row (`deletedAt`) so the history can say who deleted it; deleted expenses never count.
model Expense {
  id          String      @id @default(cuid())
  householdId String      @map("household_id")
  description String
  amountCents Int         @map("amount_cents")
  date        DateTime    @db.Date
  paidById    String      @map("paid_by_id")
  splitMethod SplitMethod @map("split_method")
  createdById String      @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  editedById  String?     @map("edited_by_id")
  editedAt    DateTime?   @map("edited_at")
  /// Starts at 1 and goes up on every edit; edits and deletes must name the version they saw.
  version     Int         @default(1)
  deletedById String?     @map("deleted_by_id")
  deletedAt   DateTime?   @map("deleted_at")
  /// Optional; deleting the category leaves the expense without one and never touches its shares.
  categoryId  String?     @map("category_id")

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paidBy    User             @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  createdBy User             @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  editedBy  User?            @relation("ExpenseEditedBy", fields: [editedById], references: [id], onDelete: Restrict)
  deletedBy User?            @relation("ExpenseDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  shares    ExpenseShare[]

  @@index([householdId, date(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([householdId, paidById])
  @@index([householdId, categoryId])
  @@map("expenses")
}

/// A kind of spending in one household ("Rent", "Dog"). Names are unique per household ignoring
/// case (expression index in the migration). A category follows the household's split unless
/// `ownSplit` is true, in which case it has one `CategoryWeight` per current member.
model ExpenseCategory {
  id           String    @id @default(cuid())
  householdId  String    @map("household_id")
  /// Trimmed, 1–30 characters.
  name         String
  /// One emoji grapheme, or null.
  emoji        String?
  /// `max + 1` within the household when created; lists are ordered by it.
  position     Int
  ownSplit     Boolean   @default(false) @map("own_split")
  /// Last time an admin saved its own split; compared with `households.members_changed_at`.
  splitSavedAt DateTime? @map("split_saved_at")
  /// Bumped on every rename, emoji change and split save; changes must name the version they saw.
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  weights   CategoryWeight[]
  expenses  Expense[]

  @@index([householdId, position])
  @@map("expense_categories")
}

/// A member's weight (0–100, enforced by a CHECK) in a category with its own split. Keyed by
/// membership, so leaving the household removes it everywhere.
model CategoryWeight {
  categoryId   String @map("category_id")
  membershipId String @map("membership_id")
  weight       Int

  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  membership Membership      @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([categoryId, membershipId])
  @@index([membershipId])
  @@map("category_weights")
}

/// One person's part of an expense. The shares of an expense add up exactly to its amount.
model ExpenseShare {
  expenseId   String @map("expense_id")
  userId      String @map("user_id")
  /// ≥ 0, enforced by a CHECK.
  amountCents Int    @map("amount_cents")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([expenseId, userId])
  @@index([userId])
  @@map("expense_shares")
}

/// Money one person gave another to settle up ("payment" on screen). Same lifecycle as expenses.
model Settlement {
  id          String    @id @default(cuid())
  householdId String    @map("household_id")
  fromUserId  String    @map("from_user_id")
  toUserId    String    @map("to_user_id")
  amountCents Int       @map("amount_cents")
  date        DateTime  @db.Date
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  editedById  String?   @map("edited_by_id")
  editedAt    DateTime? @map("edited_at")
  version     Int       @default(1)
  deletedById String?   @map("deleted_by_id")
  deletedAt   DateTime? @map("deleted_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  from      User      @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  to        User      @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Restrict)
  createdBy User      @relation("SettlementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  editedBy  User?     @relation("SettlementEditedBy", fields: [editedById], references: [id], onDelete: Restrict)
  deletedBy User?     @relation("SettlementDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  @@index([householdId, date(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([householdId, fromUserId])
  @@index([householdId, toUserId])
  @@map("settlements")
}

/// Refresh tokens are stored hashed (SHA-256), never in plain text.
/// Every rotation creates a new token in the same family; reusing a revoked
/// token revokes the whole family.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}
