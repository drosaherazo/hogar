{
  "name": "@hogar/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress",
    "e2e": "node scripts/e2e.mjs run",
    "e2e:open": "node scripts/e2e.mjs open",
    "capture": "start-server-and-test dev:e2e http://localhost:5174 \"cypress run --spec cypress/captures/palette.cy.ts --config specPattern=cypress/captures/**/*.cy.ts\"",
    "capture:small-screens": "start-server-and-test dev:e2e http://localhost:5174 \"cypress run --spec cypress/captures/small-screens.cy.ts --config specPattern=cypress/captures/**/*.cy.ts\"",
    "capture:desktop": "start-server-and-test dev:e2e http://localhost:5174 \"cypress run --spec cypress/captures/desktop.cy.ts --config specPattern=cypress/captures/**/*.cy.ts\"",
    "dev:e2e": "vite --mode e2e --port 5174 --strictPort",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@hogar/shared": "workspace:*",
    "@hogar/ui": "workspace:*",
    "@tanstack/query-sync-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "clsx": "^2.1.1",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router": "^8.5.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cypress": "^16.2.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "start-server-and-test": "^3.0.13",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
